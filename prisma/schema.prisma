generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum TimeSlot {
  morning
  daytime
  afternoon
  evening
}

enum SessionPlanningType {
  fixed
  preferred
  generated
}

enum SessionStatus {
  planned
  done
  skipped
}

enum SessionIntensity {
  easy
  moderate
  hard
}

enum GoalStatus {
  active
  paused
  completed
}

enum PlanStatus {
  draft
  active
  archived
}

enum ScheduleEventKind {
  blocked
  household
  calendar_busy
  travel
}

enum ScheduleEventSource {
  manual
  google_calendar
  wife_schedule
  derived
}

model User {
  id          String   @id @default(cuid())
  name        String
  timezone    String   @default("Europe/Warsaw")
  constraints Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  availabilityWindows AvailabilityWindow[]
  scheduleEvents      ScheduleEvent[]
  goals               Goal[]
  trainingPlans       TrainingPlan[]
  trainingSessions    TrainingSession[]
  checkIns            CheckIn[]
  recurringSessions   RecurringSession[]
  dailyReadiness      DailyReadiness[]
  stravaConnection    StravaConnection?
  stravaActivities    StravaActivity[]
}

model AvailabilityWindow {
  id           String    @id @default(cuid())
  userId       String
  dayOfWeek    DayOfWeek
  timeStartMin Int
  timeEndMin   Int
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ScheduleEvent {
  id        String              @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  kind      ScheduleEventKind
  source    ScheduleEventSource @default(manual)
  note      String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  discipline  String?
  targetDate  DateTime?  @db.Date
  priority    Int?
  status      GoalStatus @default(active)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  trainingPlanGoals TrainingPlanGoal[]
}

model RecurringSession {
  id            String              @id @default(cuid())
  userId        String
  dayOfWeek     DayOfWeek
  preferredSlot TimeSlot
  planningType  SessionPlanningType @default(fixed)
  durationMin   Int
  intensity     SessionIntensity    @default(moderate)
  notes         String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model TrainingPlan {
  id           String     @id @default(cuid())
  userId       String
  startsAt     DateTime   @db.Date
  endsAt       DateTime   @db.Date
  status       PlanStatus @default(draft)
  revision     Int        @default(1)
  parentPlanId String?
  replanReason      String?
  focusSummary      String?
  changeExplanation String?
  createdAt         DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  goals    TrainingPlanGoal[]
  sessions TrainingSession[]
  parent   TrainingPlan?      @relation("PlanRevisions", fields: [parentPlanId], references: [id])
  children TrainingPlan[]     @relation("PlanRevisions")
}

model TrainingPlanGoal {
  planId String
  goalId String

  plan TrainingPlan @relation(fields: [planId], references: [id])
  goal Goal         @relation(fields: [goalId], references: [id])

  @@id([planId, goalId])
}

model TrainingSession {
  id            String              @id @default(cuid())
  planId        String
  userId        String
  scheduledDate DateTime            @db.Date
  preferredSlot TimeSlot
  planningType  SessionPlanningType
  status        SessionStatus       @default(planned)
  durationMin   Int
  intensity     SessionIntensity
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  plan        TrainingPlan              @relation(fields: [planId], references: [id])
  user        User                      @relation(fields: [userId], references: [id])
  checkIn     CheckIn?
  stravaLinks SessionStravaActivityLink[]
}

model CheckIn {
  id          String    @id @default(cuid())
  userId      String
  sessionId   String    @unique
  occurredAt  DateTime
  feelScore   Int
  notes       String?
  coachAdvice String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  session TrainingSession @relation(fields: [sessionId], references: [id])
}

model DailyReadiness {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  feelScore   Int
  notes       String?
  tags        String[] @default([])
  category    String
  coachAdvice String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model StravaConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  stravaAthleteId String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model StravaActivity {
  id                 String   @id @default(cuid())
  userId             String
  stravaActivityId   String   @unique
  stravaAthleteId    String
  name               String
  sportType          String
  startDate          DateTime
  distance           Float    @default(0)
  movingTime         Int      @default(0)
  elapsedTime        Int      @default(0)
  totalElevationGain Float    @default(0)
  averageHeartrate   Float?
  maxHeartrate       Float?
  averageSpeed       Float    @default(0)
  maxSpeed           Float    @default(0)
  calories           Float?
  description        String?
  rawJson            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                        @relation(fields: [userId], references: [id])
  sessionLinks SessionStravaActivityLink[]

  @@index([userId, startDate])
}

model SessionStravaActivityLink {
  id               String   @id @default(cuid())
  sessionId        String
  stravaActivityId String
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id])
  activity StravaActivity  @relation(fields: [stravaActivityId], references: [id])

  @@unique([sessionId, stravaActivityId])
}

model StravaWebhookEvent {
  id         String   @id @default(cuid())
  objectType String
  objectId   String
  aspectType String
  ownerId    String
  eventTime  DateTime
  raw        Json
  createdAt  DateTime @default(now())
}
