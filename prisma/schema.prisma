generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum TimeSlot {
  morning
  daytime
  afternoon
  evening
}

enum SessionPlanningType {
  fixed
  preferred
  generated
}

enum SessionStatus {
  planned
  done
  skipped
}

enum SessionIntensity {
  easy
  moderate
  hard
}

enum GoalStatus {
  active
  paused
  completed
}

enum PlanStatus {
  draft
  active
  archived
}

enum ScheduleEventKind {
  blocked
  household
  calendar_busy
  travel
}

enum ScheduleEventSource {
  manual
  google_calendar
  wife_schedule
  derived
}

model User {
  id          String   @id @default(cuid())
  name        String
  timezone    String   @default("Europe/Warsaw")
  constraints Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  availabilityWindows AvailabilityWindow[]
  scheduleEvents      ScheduleEvent[]
  goals               Goal[]
  trainingPlans       TrainingPlan[]
  trainingSessions    TrainingSession[]
  checkIns            CheckIn[]
  recurringSessions   RecurringSession[]
  dailyReadiness      DailyReadiness[]
}

model AvailabilityWindow {
  id           String    @id @default(cuid())
  userId       String
  dayOfWeek    DayOfWeek
  timeStartMin Int
  timeEndMin   Int
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ScheduleEvent {
  id        String              @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  kind      ScheduleEventKind
  source    ScheduleEventSource @default(manual)
  note      String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  discipline  String?
  targetDate  DateTime?  @db.Date
  priority    Int?
  status      GoalStatus @default(active)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  trainingPlanGoals TrainingPlanGoal[]
}

model RecurringSession {
  id            String              @id @default(cuid())
  userId        String
  dayOfWeek     DayOfWeek
  preferredSlot TimeSlot
  planningType  SessionPlanningType @default(fixed)
  durationMin   Int
  intensity     SessionIntensity    @default(moderate)
  notes         String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model TrainingPlan {
  id           String     @id @default(cuid())
  userId       String
  startsAt     DateTime   @db.Date
  endsAt       DateTime   @db.Date
  status       PlanStatus @default(draft)
  revision     Int        @default(1)
  parentPlanId String?
  replanReason      String?
  focusSummary      String?
  changeExplanation String?
  createdAt         DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  goals    TrainingPlanGoal[]
  sessions TrainingSession[]
  parent   TrainingPlan?      @relation("PlanRevisions", fields: [parentPlanId], references: [id])
  children TrainingPlan[]     @relation("PlanRevisions")
}

model TrainingPlanGoal {
  planId String
  goalId String

  plan TrainingPlan @relation(fields: [planId], references: [id])
  goal Goal         @relation(fields: [goalId], references: [id])

  @@id([planId, goalId])
}

model TrainingSession {
  id            String              @id @default(cuid())
  planId        String
  userId        String
  scheduledDate DateTime            @db.Date
  preferredSlot TimeSlot
  planningType  SessionPlanningType
  status        SessionStatus       @default(planned)
  durationMin   Int
  intensity     SessionIntensity
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  plan    TrainingPlan @relation(fields: [planId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  checkIn CheckIn?
}

model CheckIn {
  id          String    @id @default(cuid())
  userId      String
  sessionId   String    @unique
  occurredAt  DateTime
  feelScore   Int
  notes       String?
  coachAdvice String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  session TrainingSession @relation(fields: [sessionId], references: [id])
}

model DailyReadiness {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  feelScore   Int
  notes       String?
  tags        String[] @default([])
  category    String
  coachAdvice String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}
