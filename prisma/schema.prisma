generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum TimeSlot {
  morning
  daytime
  afternoon
  evening
}

enum SessionPlanningType {
  fixed
  preferred
  generated
  manual
}

enum SessionStatus {
  planned
  done
  skipped
}

enum SessionIntensity {
  easy
  moderate
  hard
}

enum GoalStatus {
  active
  paused
  completed
}

enum PlanStatus {
  draft
  active
  archived
}

enum ScheduleEventKind {
  blocked
  household
  calendar_busy
  travel
}

enum ScheduleEventSource {
  manual
  google_calendar
  wife_schedule
  derived
}

model User {
  id               String   @id @default(cuid())
  name             String
  login            String?  @unique
  passwordHash     String?
  isActive         Boolean  @default(true)
  preferredLanguage String  @default("en")
  timezone         String   @default("Europe/Warsaw")
  constraints      Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  availabilityWindows AvailabilityWindow[]
  scheduleEvents      ScheduleEvent[]
  goals               Goal[]
  trainingPlans       TrainingPlan[]
  trainingSessions    TrainingSession[]
  checkIns            CheckIn[]
  recurringSessions   RecurringSession[]
  dailyReadiness      DailyReadiness[]
  stravaConnection    StravaConnection?
  stravaActivities    StravaActivity[]
  trainingProfile     UserTrainingProfile?
  hybridRaceProfile   HybridRaceProfile?
  workoutPlans          SessionWorkoutPlan[]
  workoutFeedbacks      SessionWorkoutFeedback[]
  nutritionProfile      NutritionProfile?
  stravaActivityStreams  StravaActivityStream[]
  aiInsightCaches       AiInsightCache[]
}

model AvailabilityWindow {
  id           String    @id @default(cuid())
  userId       String
  dayOfWeek    DayOfWeek
  timeStartMin Int
  timeEndMin   Int
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ScheduleEvent {
  id        String              @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  kind      ScheduleEventKind
  source    ScheduleEventSource @default(manual)
  note      String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  discipline  String?
  targetDate  DateTime?  @db.Date
  priority    Int?
  status      GoalStatus @default(active)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  trainingPlanGoals TrainingPlanGoal[]
}

model RecurringSession {
  id            String              @id @default(cuid())
  userId        String
  dayOfWeek     DayOfWeek
  preferredSlot TimeSlot
  planningType  SessionPlanningType @default(fixed)
  durationMin   Int
  intensity     SessionIntensity    @default(moderate)
  notes         String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model TrainingPlan {
  id           String     @id @default(cuid())
  userId       String
  startsAt     DateTime   @db.Date
  endsAt       DateTime   @db.Date
  status       PlanStatus @default(draft)
  revision     Int        @default(1)
  parentPlanId String?
  replanReason      String?
  focusSummary      String?
  changeExplanation String?
  createdAt         DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  goals    TrainingPlanGoal[]
  sessions TrainingSession[]
  parent   TrainingPlan?      @relation("PlanRevisions", fields: [parentPlanId], references: [id])
  children TrainingPlan[]     @relation("PlanRevisions")
}

model TrainingPlanGoal {
  planId String
  goalId String

  plan TrainingPlan @relation(fields: [planId], references: [id])
  goal Goal         @relation(fields: [goalId], references: [id])

  @@id([planId, goalId])
}

model TrainingSession {
  id            String              @id @default(cuid())
  planId        String
  userId        String
  scheduledDate DateTime            @db.Date
  preferredSlot TimeSlot
  planningType  SessionPlanningType
  status        SessionStatus       @default(planned)
  durationMin   Int
  intensity     SessionIntensity
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  plan            TrainingPlan                @relation(fields: [planId], references: [id])
  user            User                        @relation(fields: [userId], references: [id])
  checkIn         CheckIn?
  stravaLinks     SessionStravaActivityLink[]
  workoutPlan     SessionWorkoutPlan?
  workoutFeedback SessionWorkoutFeedback?
}

model CheckIn {
  id          String    @id @default(cuid())
  userId      String
  sessionId   String    @unique
  occurredAt  DateTime
  feelScore   Int
  notes       String?
  coachAdvice String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  session TrainingSession @relation(fields: [sessionId], references: [id])
}

model DailyReadiness {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  feelScore   Int
  notes       String?
  tags        String[] @default([])
  category    String
  coachAdvice String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model StravaConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  stravaAthleteId String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model StravaActivity {
  id                 String   @id @default(cuid())
  userId             String
  stravaActivityId   String   @unique
  stravaAthleteId    String
  name               String
  sportType          String
  startDate          DateTime
  distance           Float    @default(0)
  movingTime         Int      @default(0)
  elapsedTime        Int      @default(0)
  totalElevationGain Float    @default(0)
  averageHeartrate   Float?
  maxHeartrate       Float?
  averageSpeed       Float    @default(0)
  maxSpeed           Float    @default(0)
  calories           Float?
  description        String?
  rawJson            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                        @relation(fields: [userId], references: [id])
  sessionLinks SessionStravaActivityLink[]
  stream       StravaActivityStream?

  @@index([userId, startDate])
}

model SessionStravaActivityLink {
  id               String   @id @default(cuid())
  sessionId        String
  stravaActivityId String
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id])
  activity StravaActivity  @relation(fields: [stravaActivityId], references: [id])

  @@unique([sessionId, stravaActivityId])
}

model StravaWebhookEvent {
  id         String   @id @default(cuid())
  objectType String
  objectId   String
  aspectType String
  ownerId    String
  eventTime  DateTime
  raw        Json
  createdAt  DateTime @default(now())
}

model SessionWorkoutPlan {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  userId       String
  planType     String
  goal         String
  target       String?
  blocks       Json
  rules        Json
  alternatives Json?
  summary      String?
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
}

model UserTrainingProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  restingHr   Int?
  maxHr       Int?
  easyHrMin   Int?
  easyHrMax   Int?
  tempoHrMin  Int?
  tempoHrMax  Int?
  thresholdHr Int?
  zoneMethod  String   @default("estimated")
  zonesJson   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model HybridRaceProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  defaultFormat          String   @default("station_circuit")
  includesRunningDefault Boolean  @default(false)
  stationWorkSec         Int      @default(60)
  stationRestSec         Int      @default(20)
  defaultRounds          Int      @default(3)
  availableEquipmentJson Json?
  stationBenchmarksJson  Json?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SessionWorkoutFeedback {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  userId         String
  adherenceLabel String
  summary        String
  bullets        Json
  nextAdjustment String?
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
}

model StravaActivityStream {
  id               String   @id @default(cuid())
  userId           String
  stravaActivityId String   @unique

  time             Json?
  heartrate        Json?
  distance         Json?
  velocitySmooth   Json?
  altitude         Json?
  cadence          Json?
  watts            Json?

  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  activity StravaActivity @relation(fields: [stravaActivityId], references: [id])

  @@index([userId])
}

model NutritionProfile {
  id                                 String   @id @default(cuid())
  userId                             String   @unique
  dietNotes                          String?
  avoidFoods                         String?
  preferredBreakfast                 String?
  preferredPreWorkoutSnack           String?
  preferredPostWorkoutMeal           String?
  caffeineSensitive                  Boolean  @default(false)
  stomachSensitive                   Boolean  @default(false)
  currentMealPattern                 String?
  nutritionGoal                      String?
  minHoursAfterMainMealBeforeWorkout Int?
  preWorkoutSnackTolerance           String?
  preferredFoods                     String?
  supplements                        String?
  cookingTimePreference              String?
  bodyWeightKg                       Float?
  estimatedRestDayCalories           Int?
  calorieGoal                        String?
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AiInsightCache {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  scopeKey    String
  inputHash   String
  payload     Json
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, kind, scopeKey])
  @@index([userId, kind])
}
