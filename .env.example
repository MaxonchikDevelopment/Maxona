DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

ANTHROPIC_API_KEY="sk-ant-..."
# Optional — defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Auth (Phase A: per-user login) ────────────────────────────────────────────
# Username for the owner account. Used by prisma db seed to set the owner's login.
OWNER_LOGIN="maxon"

# Plain password for the owner account. Used by prisma db seed to generate the bcrypt hash.
# Never stored plain — only the hash is written to the DB.
OWNER_PASSWORD="your-owner-password"

# Secret used to sign session tokens (HMAC-SHA256). Must be at least 32 random characters.
# Generate with: openssl rand -hex 32
# Falls back to AUTH_PASSWORD if not set (acceptable for local dev only).
SESSION_SECRET="long-random-secret-at-least-32-chars"

# Legacy single-password auth. Keep for backward compatibility until Phase B is deployed.
# After Phase B: remove AUTH_PASSWORD from all environments.
AUTH_PASSWORD="your-secure-password"

# Full origin of the app. Must include https:// and have NO trailing slash.
# Local:      http://localhost:3000
# Production: https://maxona-ai.vercel.app
# The app builds all Strava redirect URIs as: NEXT_PUBLIC_APP_URL + "/api/strava/callback"
# Do NOT set STRAVA_REDIRECT_URI — it is not used.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"
# Random string — must match the verify_token used when registering the webhook subscription
STRAVA_WEBHOOK_VERIFY_TOKEN="your-random-webhook-verify-token"
